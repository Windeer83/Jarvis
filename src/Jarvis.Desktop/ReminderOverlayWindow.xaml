<Window x:Class="Jarvis.Desktop.ReminderOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height" MaxHeight="180"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" Topmost="True" FontFamily="Microsoft YaHei UI">
    <Border Background="#F6EED6" BorderBrush="#D19A32" BorderThickness="1"
            CornerRadius="12" Padding="14" MouseLeftButtonUp="Overlay_Click"
            ToolTip="点击打开 Jarvis 监督面板">
        <StackPanel>
            <TextBlock Text="Jarvis" FontWeight="SemiBold" Foreground="#654600" />
            <TextBlock x:Name="MessageText" Margin="0,5,0,0" TextWrapping="Wrap"
                       MaxHeight="110" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="点击查看" Margin="0,5,0,0" Foreground="#80652A" FontSize="11" />
        </StackPanel>
    </Border>
</Window>
