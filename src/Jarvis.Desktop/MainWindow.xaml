<Window x:Class="Jarvis.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis · 一次性工作承诺"
        Height="930" Width="960" MinHeight="720" MinWidth="800"
        Background="#F4F5F7" FontFamily="Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Jarvis 工作承诺" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="CoreStatusText" Text="正在连接 Jarvis Core…"
                               Foreground="#BFC9DC" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新状态"
                        Width="96" Height="34" Click="RefreshButton_Click" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="新建一次性工作承诺" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="承诺类型" VerticalAlignment="Center" Margin="0,6" />
                        <ComboBox x:Name="KindBox" Grid.Row="0" Grid.Column="1" Margin="0,4,18,4"
                                  SelectionChanged="KindBox_SelectionChanged" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="监督模式" VerticalAlignment="Center" Margin="0,6" />
                        <ComboBox x:Name="ModeBox" Grid.Row="0" Grid.Column="3" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="开始日期" VerticalAlignment="Center" Margin="0,6" />
                        <DatePicker x:Name="StartDatePicker" Grid.Row="1" Grid.Column="1" Margin="0,4,18,4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="开始时间（HH:mm）" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox x:Name="StartTimeBox" Grid.Row="1" Grid.Column="3" Margin="0,4" Padding="6" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="持续分钟" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox x:Name="DurationBox" Grid.Row="2" Grid.Column="1" Margin="0,4,18,4" Padding="6" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="提醒默认值" VerticalAlignment="Center" Margin="0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,4" VerticalAlignment="Center"
                                   Text="开始仅本机 · 偏离 5/20/20 分钟 · 最多 3 条手机提醒"
                                   TextWrapping="Wrap" Foreground="#4A5568" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="投入目标（可选）" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox x:Name="InputGoalBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                 Margin="0,4" Padding="6" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="成果目标（可选）" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox x:Name="OutcomeGoalBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                 Margin="0,4" Padding="6" />

                        <TextBlock x:Name="AppsLabel" Grid.Row="5" Grid.Column="0" Text="相关软件" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox x:Name="AppsBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                                 Margin="0,4" Padding="6" ToolTip="多个软件用逗号分隔，例如 Excel.exe, Obsidian.exe" />

                        <TextBlock x:Name="SitesLabel" Grid.Row="6" Grid.Column="0" Text="相关网站" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox x:Name="SitesBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
                                 Margin="0,4" Padding="6" ToolTip="多个域名用逗号分隔，例如 tradingview.com" />

                        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="PreviewButton" Content="生成承诺卡片" Width="130" Height="36"
                                    Click="PreviewButton_Click" />
                            <TextBlock x:Name="FormHintText" Margin="12,8,0,0" Foreground="#5B6474"
                                       Text="至少填写投入目标或成果目标；电脑型承诺至少填写一个相关软件或网站。" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <Border x:Name="CardBorder" Visibility="Collapsed" Background="#FFF7DB"
                        BorderBrush="#E7B84B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="承诺卡片 · 等待确认" FontSize="18" FontWeight="SemiBold" Foreground="#6A4B00" />
                        <TextBlock x:Name="CardText" Margin="0,10,0,12" TextWrapping="Wrap" LineHeight="23" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ConfirmButton" Content="确认，正式成立" Width="140" Height="36"
                                    Click="ConfirmButton_Click" />
                            <Button Content="放弃这张卡片" Width="120" Height="36" Margin="10,0,0,0"
                                    Click="DiscardCardButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="SupervisionPanel" Visibility="Collapsed" Background="#EEF4FF"
                        BorderBrush="#7296D8" BorderThickness="1" CornerRadius="10"
                        Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="当前监督" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#244A86" />
                            <TextBlock x:Name="ReminderMarkerText" DockPanel.Dock="Right"
                                       Text="● 有待处理提醒" Foreground="#B54708"
                                       FontWeight="SemiBold" Visibility="Collapsed" />
                        </DockPanel>
                        <TextBlock x:Name="ActiveSupervisionText" Margin="0,8,0,8"
                                   TextWrapping="Wrap" LineHeight="22" />
                        <Border x:Name="ReminderBubble" Background="#FFF4D6" CornerRadius="8"
                                Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock x:Name="ReminderBubbleText" TextWrapping="Wrap" />
                        </Border>
                        <WrapPanel>
                            <Button Content="马上回去" Margin="0,0,8,8" Padding="12,5"
                                    Click="ReturnNowButton_Click" />
                            <Button Content="本次活动相关" Margin="0,0,8,8" Padding="12,5"
                                    Click="CurrentRelatedButton_Click" />
                            <Button Content="本次活动分心" Margin="0,0,8,8" Padding="12,5"
                                    Click="CurrentDistractingButton_Click" />
                            <ComboBox x:Name="RuleScopeBox" Width="120" Height="30" Margin="0,0,8,8" />
                            <Button x:Name="AcceptRestButton" Content="确认正在休息" Margin="0,0,8,8"
                                    Padding="12,5" Click="AcceptRestButton_Click" />
                            <Button x:Name="DenyRestButton" Content="不是休息" Margin="0,0,8,8"
                                    Padding="12,5" Click="DenyRestButton_Click" />
                            <TextBox x:Name="RestEndTimeBox" Width="72" Height="30" Margin="0,0,6,8"
                                     Padding="5" ToolTip="主动休息结束时间，例如 15:20" />
                            <Button Content="主动限时休息" Margin="0,0,8,8" Padding="12,5"
                                    Click="StartTimedRestButton_Click" />
                        </WrapPanel>
                        <WrapPanel Margin="0,2,0,0">
                            <CheckBox x:Name="MuteSoundBox" Content="静音" Margin="0,0,14,0"
                                      Checked="PresentationMode_Changed" Unchecked="PresentationMode_Changed" />
                            <CheckBox x:Name="QuietModeBox" Content="安静/会议/演示（隐藏气泡）"
                                      Margin="0,0,14,0" Checked="PresentationMode_Changed"
                                      Unchecked="PresentationMode_Changed" />
                            <TextBlock x:Name="FullscreenStateText" Text="全屏自动识别：否"
                                       Margin="0,0,14,0" />
                            <TextBlock Text="安静/会议/演示由你明确开启；全屏自动识别。它们只改变本机呈现，不改变 Core 计时。"
                                       Foreground="#5B6474" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <GroupBox Header="Core 正式状态" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="ProjectionText" Text="等待快照…" Margin="2,0,0,8" Foreground="#344054" />
                        <DataGrid x:Name="CommitmentGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" Height="230" SelectionChanged="CommitmentGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="90" />
                                <DataGridTextColumn Header="投入目标" Binding="{Binding InputGoal}" Width="*" />
                                <DataGridTextColumn Header="成果目标" Binding="{Binding OutcomeGoal}" Width="*" />
                                <DataGridTextColumn Header="开始" Binding="{Binding StartAt.LocalDateTime, StringFormat={}{0:MM-dd HH:mm}}" Width="120" />
                                <DataGridTextColumn Header="结束" Binding="{Binding EndAt.LocalDateTime, StringFormat={}{0:MM-dd HH:mm}}" Width="120" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Phase}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ConfirmOfflineButton" Content="确认已开始线下工作" Height="34" Width="170"
                                    IsEnabled="False" Click="ConfirmOfflineButton_Click" />
                            <TextBlock x:Name="LatestReminderText" Margin="14,8,0,0" Foreground="#5B6474" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#E7EAF0" CornerRadius="8" Padding="10" Margin="0,14,0,0">
            <TextBlock x:Name="OperationStatusText" Text="准备就绪" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
