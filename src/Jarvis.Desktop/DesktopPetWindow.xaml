<Window x:Class="Jarvis.Desktop.DesktopPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis 桌宠" Width="270" Height="390"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True">
    <Window.Resources>
        <Storyboard x:Key="BreathingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CharacterScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.012" Duration="0:0:2.4" />
            <DoubleAnimation Storyboard.TargetName="CharacterTranslate"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-3" Duration="0:0:2.4" />
        </Storyboard>
    </Window.Resources>
    <Grid Background="Transparent">
        <Border x:Name="SpeechBubble" Visibility="Collapsed" VerticalAlignment="Top"
                Margin="4,2,4,0" Padding="11,8" CornerRadius="12"
                Background="#F2F7FF" BorderBrush="#6EA8FE" BorderThickness="1.2">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="#18243A"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DetailText" Margin="0,3,0,0" Foreground="#4B5870"
                           FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border VerticalAlignment="Bottom" Margin="0,52,0,18" CornerRadius="24"
                Background="#180D1C33" BorderBrush="#4D7DD3FC" BorderThickness="1">
            <Image x:Name="CharacterImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CharacterScale" CenterX="0.5" CenterY="1" />
                        <TranslateTransform x:Name="CharacterTranslate" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Border>

        <Border x:Name="StateBadge" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="8" Padding="12,6" CornerRadius="14"
                Background="#E6192436" BorderBrush="#997DD3FC" BorderThickness="1">
            <TextBlock x:Name="StateBadgeText" Foreground="White" FontSize="12"
                       FontWeight="SemiBold" />
        </Border>

        <Grid.ContextMenu>
            <ContextMenu Opened="PetMenu_Opened">
                <MenuItem x:Name="MenuStatus" Header="Jarvis 已就绪" IsEnabled="False" />
                <Separator />
                <MenuItem Header="打开对话与控制面板" Click="OpenPanelMenu_Click" />
                <MenuItem Header="新建承诺" Click="CreateCommitmentMenu_Click" />
                <MenuItem Header="休息 15 分钟" Click="StartRestMenu_Click" />
                <Separator />
                <MenuItem x:Name="AutoMoveMenu" Header="空闲时自动移动" IsCheckable="True"
                          Click="AutoMoveMenu_Click" />
                <MenuItem x:Name="ProfessionalModeMenu" Header="专业模式（演示时隐藏）"
                          IsCheckable="True" Click="ProfessionalModeMenu_Click" />
                <MenuItem x:Name="HideCurrentProcessMenu" Header="在当前软件中自动隐藏"
                          Click="HideCurrentProcessMenu_Click" />
                <MenuItem x:Name="ClickThroughMenu" Header="鼠标穿透（Ctrl+Alt+J 恢复）"
                          IsCheckable="True" Click="ClickThroughMenu_Click" />
                <MenuItem Header="尺寸">
                    <MenuItem Header="80%" Tag="0.8" Click="ScaleMenu_Click" />
                    <MenuItem Header="100%" Tag="1.0" Click="ScaleMenu_Click" />
                    <MenuItem Header="120%" Tag="1.2" Click="ScaleMenu_Click" />
                </MenuItem>
                <MenuItem Header="重置位置与大小" Click="ResetMenu_Click" />
                <Separator />
                <MenuItem Header="隐藏桌宠" Click="HideMenu_Click" />
                <MenuItem Header="完全退出 Jarvis" Click="ExitMenu_Click" />
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
